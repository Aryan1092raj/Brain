# Get a free API key at https://console.groq.com
GROQ_API_KEY=

# GitHub personal access token (for PR comments, diff fetching)
GITHUB_TOKEN=

# Optional alert channels
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional
BRAIN_PORT=3747
BRAIN_LOG_LEVEL=info
BRAIN_AUTO_COMMIT=false

# Optional local guardrails. The defaults target the Groq free tier.
BRAIN_LLM_MODEL=llama-3.1-8b-instant
BRAIN_GROQ_RPM=30
BRAIN_GROQ_TPM=6000
BRAIN_GROQ_RPD=14400
